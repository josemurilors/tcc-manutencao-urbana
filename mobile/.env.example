# --- API -------------------------------------------------------------------
#
# Em DESENVOLVIMENTO você normalmente não precisa definir nada aqui: o app
# deriva a base da API do host do Metro (`hostUri`) e usa a porta 8000. Assim
# o navegador cai em http://localhost:8000 e o celular no Expo Go cai em
# http://<IP-da-máquina>:8000 — sem editar nada quando o IP do DHCP muda.
#
# Só defina EXPO_PUBLIC_API_URL para forçar um destino específico (por exemplo,
# rodar o app de dev contra a API de produção):
# EXPO_PUBLIC_API_URL=https://tcc.josemurilors.com.br
#
# Se o backend local não estiver na 8000:
# EXPO_PUBLIC_API_PORT=8000

# --- Google Maps -----------------------------------------------------------
#
# Necessárias apenas para builds nativos (no Expo Go o mapa usa a chave do
# próprio Expo). Ficam fora do bundle: são lidas pelo app.config.js no build.
# Nos builds EAS a chave Android já vem das Environment variables do projeto
# na Expo; só defina aqui para `expo prebuild` / build local.
# GOOGLE_MAPS_API_KEY_ANDROID=
# GOOGLE_MAPS_API_KEY_IOS=
